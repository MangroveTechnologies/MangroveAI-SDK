{
  "name": "@mangrove-ai/sdk",
  "version": "1.0.0",
  "description": "Server-side TypeScript SDK for the MangroveAI public REST and Oracle proxy APIs",
  "homepage": "https://github.com/MangroveTechnologies/MangroveAI-SDK/tree/main/packages/typescript",
  "keywords": ["mangroveai", "sdk", "typescript", "rest"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}},
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {"node": ">=20"},
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/MangroveTechnologies/MangroveAI-SDK.git", "directory": "packages/typescript"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {"typescript": "5.9.3"}
}
